#FATIAMENTO / SLICE de Listas
#Sintaxe : lista[inicio : fim]
#Neste caso, ele COMEÇA do indice (inicio), mas só vai até (fim-1).
#Alem disso, é NÃO DESTRUTIVO, o que significa que o retorno é uma "CÓPIA".
#Ou seja, o vetor inicial não é alterado.
frutas = ["maca", "laranja", "banana", "kiwi", "uva"]
frutas[1:3] #Retorna ["laranja", "banana"]
frutas[ : 2] #Retorna ["maca", "laranja"]. Omissão = começa do inicio
frutas[2: ] #Retorna ["banana", "kiwi","uva"] #Começa do indice 2 e vai até o ultimo.

#IMPORTANTE : Sobre referencia
frutas[ : ] #Retorna a lista inteira. Como é uma cópia, é bastante útil para copiar a lista para outra variável
outra_lista = frutas #outra_lista tem uma referencia ao vetor. Qualquer alteração afeta frutas
outra_lista = frutas[:] #Copia apenas os elementos. Alterações em outra_lista não afeta a lista "frutas"


