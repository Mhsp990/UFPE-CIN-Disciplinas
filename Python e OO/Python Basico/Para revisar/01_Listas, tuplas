# DICIONARIOS
#Usam "{ }"
#Não tem ordem. Ou seja, a ordem nao é garantida. A busca é feita por chaves.
#Neste caso, use as chaves, que são strings, como indices.

#Dicionarios podem resultar em error para chaves (similar a indices) invalidos
#Para evitar, use o metodo .get()
pontuacao = {"Pedro" : 12, "Cesar" : 20, "Igor" : 30}
pontuacao #Imprime {'Pedro' : 12, 'Cesar' : 20, 'Igor' : 30}
pontuacao['Pedro'] # Retorna 12
pontuacao['Igor'] #Retorna 30
pontuacao['Nome inexistente'] #Resultam em Erro, pois a chave é invalida
len(pontuacao) # Resulta em 3 (numero de chaves)
pontuacao.get("Pedro", 0) #Mesma coisa de pontuacao['Pedro'], mas resulta em 0 caso seja uma chave INVALIDA


for n in pontuacao:
    print(n)
