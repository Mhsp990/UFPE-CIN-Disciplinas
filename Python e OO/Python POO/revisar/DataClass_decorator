from dataclasses import dataclass

@dataclass
class Sensor:
    nome : str
    alcance : int

s1 = Sensor("ré", 1)
print(s1) #Sensor( nome = 'ré', alcance = 1)

@dataclass
class Bateria:
    nivel : int
    capacidade_max : int = 100

    def percentual(self):
        return (self.nivel/self.capacidade_max)*100

b = Bateria(60)
print(b.percentual())


@dataclass(frozen = True)
class Posicao:
    x : int
    y : int
    pass


@dataclass(frozen = True)
class Comando:
    acao : str
    valor : int | str

@dataclass
class HistoricoMovimento:
    origem : Posicao
    comando : Comando

hist1 = HistoricoMovimento(Posicao(0,0), Comando('AVANCAR', 3))
print(hist1)

posicoes = [Posicao(3,7), Posicao(2,4), Posicao(3,3)]
print(posicoes)
#print(sorted(posicoes)) #Não funciona, precisa do magic method definido na classe em questão.
